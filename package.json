{
  "name": "ghost-wheel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p client/tsconfig.json && tsc -p server/tsconfig.json",
    "kill-ports": "pkill -f 'concurrently -n client,server' ; pkill -f 'watch server/index.ts' ; pkill -f 'node_modules/.bin/vite' ; echo 'stale dev processes stopped'"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
