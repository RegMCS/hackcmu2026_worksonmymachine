# --- Persistence -----------------------------------------------------------
# Optional. Without it the server uses a local JSON file, which is fine for
# development and is also the fallback if Atlas is unreachable during a demo.
# NOTE: the browser cannot talk to Atlas directly - the Atlas Data API reached
# end-of-life in September 2025 - so this server is the only way in.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=ghostrace

# --- Gemini (commentary text) ----------------------------------------------
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite
# 'minimal' measured fastest with zero thought tokens. Do NOT use thinkingBudget
# on Gemini 3.x - this model rejects it with a 400.
# GEMINI_THINKING_LEVEL=minimal

# --- ElevenLabs (commentary audio) -----------------------------------------
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=IKne3meq5aSn9XLyUdCD
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Character budget guard for LIVE generation. The free tier is 10,000 credits a
# month and Flash bills 0.5 credits/char, so live-only commentary would cover
# roughly a dozen races. The pre-cached phrase bank is the primary path.
# TTS_CHAR_BUDGET=12000

# --- Server ----------------------------------------------------------------
# PORT=8787
# DATA_FILE=data/runs.json
