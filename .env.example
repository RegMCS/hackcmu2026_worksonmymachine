# Copy to .env. Both keys are optional: without them the commentator falls back
# to canned lines and browser text-to-speech.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ELEVENLABS_API_KEY=
# Leave empty to use the first voice in your ElevenLabs account (free plans can't use library voices).
ELEVENLABS_VOICE_ID=
PORT=8787
