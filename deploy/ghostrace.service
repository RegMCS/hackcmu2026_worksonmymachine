# systemd unit for the GhostRace API + static server.
#   sudo cp deploy/ghostrace.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ghostrace

[Unit]
Description=GhostRace server
After=network.target

[Service]
Type=simple
User=ghostrace
WorkingDirectory=/opt/ghostrace
EnvironmentFile=/opt/ghostrace/.env
ExecStart=/usr/bin/node dist/server/src/index.js
Restart=always
RestartSec=3
# The demo must survive a crash without anyone noticing.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
